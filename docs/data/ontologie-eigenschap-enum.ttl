# Enumeratie voor kleuren
ex-ont:KleurType rdf:type nen2660:EnumerationType ;
    skos:prefLabel "Kleuren"@nl,
                   "Colours"@en .

# Twee enumeratiewaarden met een naam per taal
ex-data:Geel rdf:type ex-ont:KleurType ;
    skos:prefLabel "Geel"@nl,
                   "Yellow"@en .

ex-data:Blauw rdf:type ex-ont:KleurType ;
    skos:prefLabel "Blauw"@nl,
                   "Blue"@en .

# Eigenschap met tweetalige naam
ex-ont:kleur rdf:type rdf:Property ;
    skos:prefLabel "Kleur"@nl,
                   "Colour"@en .

# Eigenschap met als waardetype een enumeratie. Deze property shape legt vast
# dat alle waarden voor eigenschap ex-ont:kleur uit de enumeratie
# ex-ont:KleurType moeten komen. Deze eigenschap moet precies één keer
# voorkomen per individu.
ex-ont:GebouwKleur rdf:type sh:PropertyShape ;
    sh:path ex-ont:kleur ;
    sh:class ex-ont:KleurType ;
    sh:minCount 1 ;
    sh:maxCount 1 .

# Koppeling van de klasse aan de property shape
ex-ont:Gebouw rdf:type rdfs:Class .

ex-ont:GebouwShape rdf:type sh:NodeShape ;
    sh:targetClass ex-ont:Gebouw ;
    sh:property ex-ont:GebouwKleur .

# Instantiëring - een individueel gebouw met een kleur
ex-data:Gebouw_123 rdf:type ex-ont:Gebouw ;
    ex-ont:kleur ex-data:Geel .

# Deze instantie zal bij validatie een foutmelding geven:
# ex-data:Zwart is geen enumeratiewaarde.
ex-data:Gebouw_456 rdf:type ex-ont:Gebouw ;
    ex-ont:kleur ex-data:Zwart .
